# Copy to .env and fill in. Never commit .env or a real key.
# Team-scoped open-model gateway (verified 2026-10-27).
MUTANT_BASE_URL=https://api.tryalan.ai/public/harness/v1
MUTANT_MODEL=deepseek/deepseek-v4.1-flash
MUTANT_API_KEY=replace-me

# The gateway rejects a bare bearer token. A standard OpenAI client must also send:
#   x-alan-conversation-id: <your Alan conversation id>
# Only the models enabled for the team are accepted; others return 403.
